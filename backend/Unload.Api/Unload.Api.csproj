<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <FrontendRoot>$(MSBuildProjectDirectory)/../../web/webApp</FrontendRoot>
    <FrontendDist>$(FrontendRoot)/dist/webApp/browser</FrontendDist>
    <DefineConstants Condition="'$(DesktopBuild)' == 'true'">$(DefineConstants);DESKTOP_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unload.Bootstrapper\Unload.Bootstrapper.csproj" />
    <ProjectReference Include="..\Unload.Gateway\Unload.Gateway.csproj" />
    <ProjectReference Include="..\Unload.Store\Unload.Store.csproj" />
    <ProjectReference Include="..\Unload.Tasks\Unload.Tasks.csproj" />
    <ProjectReference Include="..\Unload.Tasks.ExtraUnload\Unload.Tasks.ExtraUnload.csproj" />
    <ProjectReference Include="..\Unload.Tasks.MainUnload\Unload.Tasks.MainUnload.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="NLog.Web.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <None Update="nlog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(DesktopBuild)' == 'true'">
    <Content Include="../../configs/**/*" Link="configs/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../scripts/**/*" Link="scripts/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildDesktopFrontend" BeforeTargets="ComputeFilesToPublish" Condition="'$(DesktopBuild)' == 'true'">
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm run build" />
    <ItemGroup>
      <DesktopFrontendFiles Include="$(FrontendDist)/**/*" />
      <ResolvedFileToPublish Include="@(DesktopFrontendFiles)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
