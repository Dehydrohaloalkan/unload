{
    "Gateway": {
        "Ftp": {
            "Host": "ftp-server",
            "Port": 21,
            "Username": "unload",
            "Password": "unload",
            "RemoteDirectory": "/target",
            "StagingDirectory": "/staging",
            "ConnectTimeoutMs": 30000
        }
    },
    "Database": {
        "TimeoutSeconds": 30,
        "ConnectionString": "Server=localhost;Database=unload_prod;User Id=prod_user;Password=prod_password;"
    },
    "PresetGate": {
        "Enabled": true,
        "StartHour": 9,
        "StartMinute": 30,
        "PollIntervalSeconds": 60,
        "ProbeSql": "/* PRESET_READY_PROBE */ SELECT 1"
    },
    "HistoryRetention": {
        "RetentionDays": 14,
        "PruneIntervalMinutes": 60
    }
}
