{
    "Gateway": {
        "Ftp": {
            "Host": "localhost",
            "Port": 21,
            "Username": "unload",
            "Password": "unload",
            "RemoteDirectory": "/target",
            "StagingDirectory": "/staging",
            "ConnectTimeoutMs": 30000
        }
    },
    "Database": {
        "TimeoutSeconds": 30,
        "Databases": [
            {
                "Id": "unload-dev",
                "Name": "Unload Development",
                "ConnectionString": "Server=localhost;Database=unload_dev;"
            },
            {
                "Id": "unload-test",
                "Name": "Unload Test",
                "ConnectionString": "Server=localhost;Database=unload_test;"
            }
        ]
    },
    "Runner": {
        "WorkerCount": 4
    },
    "PresetGate": {
        "Enabled": true,
        "StartHour": 9,
        "StartMinute": 30,
        "PollIntervalSeconds": 60,
        "ProbeSql": "/* PRESET_READY_PROBE */ SELECT 1"
    },
    "HistoryRetention": {
        "RetentionDays": 14,
        "PruneIntervalMinutes": 60
    },
    "Extra": {
        "ChunkSizeBytes": 10485760,
        "ScriptsFolderName": "extra",
        "AtomicFolderName": "atomic",
        "BanksScriptName": "_banks.sql"
    }
}
