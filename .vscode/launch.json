{
    "version": "0.2.0",
    "configurations": [
        {
            // Use IntelliSense to find out which attributes exist for C# debugging
            // Use hover for the description of the existing attributes
            // For further information visit https://github.com/dotnet/vscode-csharp/blob/main/debugger-launchjson.md.
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            // If you have changed target frameworks, make sure to update the program path.
            "program": "${workspaceFolder}/backend/Unload.Api/bin/Debug/net10.0/Unload.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/backend/Unload.Api",
            "stopAtEntry": false,
            // Enable launching a web browser when ASP.NET Core starts. For more information: https://aka.ms/VSCode-CS-LaunchJson-WebBrowser
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
        {
            "name": "API: Debug (Unload.Api)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "api:build",
            "program": "${workspaceFolder}/backend/Unload.Api/bin/Debug/net10.0/Unload.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/backend/Unload.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "FTP Server (Unload.FtpServer)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "ftp:build",
            "program": "${workspaceFolder}/console/Unload.FtpServer/bin/Debug/net10.0/Unload.FtpServer.dll",
            "args": [
                "--port",
                "21",
                "--root",
                "${workspaceFolder}/ftp-root"
            ],
            "cwd": "${workspaceFolder}/console/Unload.FtpServer",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "FTP Handler (Unload.GatewayHandler)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "handler:build",
            "program": "${workspaceFolder}/console/Unload.GatewayHandler/bin/Debug/net10.0/Unload.GatewayHandler.dll",
            "args": [
                "${workspaceFolder}/ftp-root"
            ],
            "cwd": "${workspaceFolder}/console/Unload.GatewayHandler",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Web: Debug (Edge)",
            "type": "pwa-msedge",
            "request": "launch",
            "preLaunchTask": "web:serve",
            "url": "http://localhost:4200",
            "webRoot": "${workspaceFolder}/web/webApp",
            "sourceMaps": true
        }
    ],
    "compounds": [
        {
            "name": "Full stack: Debug (API + Web)",
            "configurations": [
                "API: Debug (Unload.Api)",
                "Web: Debug (Edge)"
            ],
            "stopAll": true
        },
        {
            "name": "Run All (FTP Server + Handler + API + Web)",
            "configurations": [
                "FTP Server (Unload.FtpServer)",
                "FTP Handler (Unload.GatewayHandler)",
                "API: Debug (Unload.Api)",
                "Web: Debug (Edge)"
            ],
            "stopAll": true
        }
    ]
}